# API ключ Venice AI (ОБЯЗАТЕЛЬНО)
# Получить на https://venice.ai
VENICE_API_KEY=ВАШ_API_КЛЮЧ_ЗДЕСЬ

# Модель (опционально)
VENICE_MODEL=qwen3-6-35b-a3b

# Макс. токенов (опционально)
VENICE_MAX_TOKENS=4096

# Температура (опционально)
VENICE_TEMPERATURE=0.8

# Директория отчётов (опционально)
VENICE_REPORTS_DIR=/root/venice_substitution_reports
